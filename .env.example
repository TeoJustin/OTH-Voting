# Hedera Testnet operator credentials.
# Create a free Testnet account at https://portal.hedera.com/
# Copy this file to ".env" and fill in your values.
#
# Account 1 is the deployer and becomes the contract owner.
# Further accounts use a numeric suffix and let you call the contract from a
# second and third identity, see "node call.js <method> --as 2".

HEDERA_OPERATOR_ID=0.0.xxxxx
HEDERA_OPERATOR_KEY=302e0201...   # ECDSA or ED25519 private key (hex or DER)

HEDERA_OPERATOR_ID_2=0.0.xxxxx
HEDERA_OPERATOR_KEY_2=302e0201...

# HEDERA_OPERATOR_ID_3=0.0.xxxxx
# HEDERA_OPERATOR_KEY_3=302e0201...
